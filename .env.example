# Loaded only with --env-file .env. Process variables win. Never commit real keys.
APIFY_TOKEN=
# Optional token rotation for authenticated Apify media fallback:
# APIFY_TOKENS=first,second
CREATIVE_RESEARCH_LOG_LEVEL=INFO
CREATIVE_RESEARCH_LOG_FORMAT=text
CREATIVE_RESEARCH_REQUEST_TIMEOUT=30
CREATIVE_RESEARCH_SUBPROCESS_TIMEOUT=900
# CREATIVE_RESEARCH_PROJECT_ROOT=/absolute/path/to/project
# NO_COLOR=1
