# Loaded only with: creative-research --env-file .env <command>
# Existing process variables take precedence. Do not commit real secrets.
# Values containing spaces must be quoted. No shell expansion is performed.

# Optional paid capture / media fallback credential.
APIFY_TOKEN=
# Optional paid Vision / explicit family-judge credential.
GEMINI_API_KEY=

# Default is the current directory; --root takes precedence.
# CREATIVE_RESEARCH_PROJECT_ROOT=/absolute/path/to/creative-research

# Application logs use stderr. DEBUG/INFO/WARNING/ERROR/CRITICAL; text or json.
CREATIVE_RESEARCH_LOG_LEVEL=INFO
CREATIVE_RESEARCH_LOG_FORMAT=text

# Finite positive seconds; command-specific budgets remain separate.
# Direct video downloads and Apify medium-duration HTTP operations.
CREATIVE_RESEARCH_REQUEST_TIMEOUT=30
# Whole yt-dlp child process (its internal socket timeout is 30 seconds).
CREATIVE_RESEARCH_SUBPROCESS_TIMEOUT=900
# Local HTTP socket reads/writes; not an overall task execution deadline.
CREATIVE_RESEARCH_SERVER_REQUEST_TIMEOUT=15
# Gemini HTTP calls; video upload processing has a separate command option.
CREATIVE_RESEARCH_AI_TIMEOUT=90

# Uncomment to disable ANSI colors even in a terminal.
# NO_COLOR=1
